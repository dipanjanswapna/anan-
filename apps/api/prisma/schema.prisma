generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  SELLER
  ADMIN
  STAFF
}

enum SellerStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum SellerApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum OtpPurpose {
  CUSTOMER_LOGIN
  CUSTOMER_SIGNUP
  SELLER_PHONE_VERIFICATION
}

enum OrderStatus {
  PENDING_SELLER_ACCEPTANCE
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum SellerOrderStatus {
  PENDING_ACCEPTANCE
  ACCEPTED
  REJECTED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum ProductStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ARCHIVED
}

model User {
  id              String         @id @default(cuid())
  name            String?
  email           String?        @unique
  phone           String?        @unique
  passwordHash    String?
  role            UserRole       @default(CUSTOMER)
  isActive        Boolean        @default(true)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  sellerProfile   SellerProfile?
  sessions        CustomerSession[]
  addresses       CustomerAddress[]
  cartItems       CartItem[]
  wishlistItems   WishlistItem[]
  orders          Order[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([role, isActive])
}

model CustomerSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model CustomerAddress {
  id            String   @id @default(cuid())
  userId        String
  label         String   @default("Home")
  recipientName String
  phone         String
  division      String
  district      String
  upazila       String
  area          String
  addressLine   String
  postalCode    String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault, createdAt])
}

model SellerProfile {
  id                String       @id @default(cuid())
  userId            String       @unique
  storeName         String
  storeSlug         String       @unique
  status            SellerStatus @default(PENDING)
  verificationNotes String?
  user              User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  products          Product[]
  orders             SellerOrder[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([status, createdAt])
}

model SellerApplication {
  id           String                  @id @default(cuid())
  contactName  String
  email        String                  @unique
  phone        String                  @unique
  storeName    String
  storeSlug    String                  @unique
  businessType String
  message      String?
  status       SellerApplicationStatus @default(PENDING)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([status, createdAt])
}

model OtpChallenge {
  id         String     @id @default(cuid())
  phone      String
  purpose    OtpPurpose
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([phone, purpose, createdAt])
  @@index([expiresAt])
}

model Category {
  id          String     @id @default(cuid())
  nameEn      String
  nameBn      String?
  slug        String     @unique
  isActive    Boolean    @default(true)
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryTree")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId, isActive])
}

model Product {
  id                   String        @id @default(cuid())
  sellerId             String
  categoryId           String
  nameEn               String
  nameBn               String?
  slug                 String        @unique
  descriptionEn        String?
  descriptionBn        String?
  pricePaisa           BigInt
  compareAtPricePaisa  BigInt?
  stockOnHand          Int           @default(0)
  status               ProductStatus @default(DRAFT)
  seller               SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  category             Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  cartItems             CartItem[]
  wishlistItems         WishlistItem[]
  orderItems            OrderItem[]

  @@index([sellerId, status, createdAt])
  @@index([categoryId, status])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, updatedAt])
  @@index([productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
}


model Order {
  id                String        @id @default(cuid())
  userId            String
  idempotencyKey    String
  status            OrderStatus   @default(PENDING_SELLER_ACCEPTANCE)
  paymentMethod     PaymentMethod @default(CASH_ON_DELIVERY)
  paymentStatus     PaymentStatus @default(UNPAID)
  subtotalPaisa     BigInt
  deliveryFeePaisa  BigInt        @default(0)
  totalPaisa        BigInt
  addressSnapshot   Json
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  sellerOrders      SellerOrder[]
  items             OrderItem[]
  events            OrderEvent[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model SellerOrder {
  id                String            @id @default(cuid())
  orderId           String
  sellerId          String
  status            SellerOrderStatus @default(PENDING_ACCEPTANCE)
  acceptanceDeadlineAt DateTime?
  subtotalPaisa     BigInt
  deliveryFeePaisa  BigInt            @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  order             Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  seller            SellerProfile     @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  items             OrderItem[]

  @@unique([orderId, sellerId])
  @@index([sellerId, status, createdAt])
  @@index([status, acceptanceDeadlineAt])
}

model OrderItem {
  id                String      @id @default(cuid())
  orderId           String
  sellerOrderId     String
  productId         String
  productNameEn     String
  productNameBn     String?
  quantity          Int
  unitPricePaisa    BigInt
  lineTotalPaisa    BigInt
  createdAt         DateTime    @default(now())
  order             Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sellerOrder       SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  product           Product     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([sellerOrderId])
  @@index([productId])
}


model OrderEvent {
  id          String   @id @default(cuid())
  orderId     String
  actorUserId String?
  actorRole   String
  eventType   String
  note        String?
  metadata    Json?
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([actorUserId, createdAt])
}
