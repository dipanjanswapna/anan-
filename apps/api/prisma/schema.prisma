generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  SELLER
  ADMIN
  STAFF
}

enum SellerStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ARCHIVED
}

model User {
  id            String         @id @default(cuid())
  email         String?        @unique
  phone         String?        @unique
  passwordHash  String?
  role          UserRole       @default(CUSTOMER)
  isActive      Boolean        @default(true)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  sellerProfile SellerProfile?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([role, isActive])
}

model SellerProfile {
  id             String       @id @default(cuid())
  userId         String       @unique
  storeName      String
  storeSlug      String       @unique
  status         SellerStatus @default(PENDING)
  verificationNotes String?
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  products       Product[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, createdAt])
}

model Category {
  id          String     @id @default(cuid())
  nameEn      String
  nameBn      String?
  slug        String     @unique
  isActive    Boolean    @default(true)
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryTree")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId, isActive])
}

model Product {
  id                   String        @id @default(cuid())
  sellerId             String
  categoryId           String
  nameEn               String
  nameBn               String?
  slug                 String        @unique
  descriptionEn        String?
  descriptionBn        String?
  pricePaisa           BigInt
  compareAtPricePaisa  BigInt?
  stockOnHand          Int           @default(0)
  status               ProductStatus @default(DRAFT)
  seller               SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  category             Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([sellerId, status, createdAt])
  @@index([categoryId, status])
}

model AuthSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, revokedAt, expiresAt])
}
