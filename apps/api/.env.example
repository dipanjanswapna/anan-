# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://anan:anan_local_dev@localhost:5432/anan_dev?schema=public

# Product image uploads (optional in local development)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Prefer a CloudFront HTTPS distribution URL for a private S3 bucket.
MEDIA_PUBLIC_BASE_URL=
